# Copy to .env and fill in real secrets before deploying.

NODE_ENV=development
PORT=4000

# Database (defaults to ./data/erp.db if not set)
# DB_PATH=/var/data/erp.db

# JWT — MUST change these in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Used to build the password-reset link sent by email
FRONTEND_URL=http://localhost:5173

# Gmail SMTP — used for "Forgot password" reset emails.
# 1. Enable 2-Step Verification on this Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (NOT your normal Gmail password).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=replace-with-16-char-app-password
GMAIL_FROM_NAME=ERP System
