# Copy to .env and fill in real values before running.

NODE_ENV=development
PORT=4000

# Database (defaults to ./data/erp.db if not set)
# DB_PATH=/var/data/erp.db

# JWT — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run the command TWICE — use a different value for each secret.
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
